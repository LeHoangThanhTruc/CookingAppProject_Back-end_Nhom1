# Shared with the authentication module. Never commit the real secret.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Local defaults; use persistent paths when deploying.
DATABASE_PATH=database.db
UPLOAD_DIR=uploads

# --- Mã OTP quên mật khẩu qua email (tùy chọn) ---
# Không cấu hình SMTP thì mã OTP được in trong terminal của uvicorn (chế độ dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# --- Đăng nhập Google / Facebook (tùy chọn) ---
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret